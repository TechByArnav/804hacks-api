# 804 Hacks Carbon API - Environment Variables
# Copy to .env and fill in your API keys

# PJM API (for real-time Virginia grid data)
PJM_API_KEY=your_pjm_api_key_here

# EIA API (for generation mix data)
EIA_API_KEY=your_eia_api_key_here

# WattTime API (alternative carbon intensity source)
WATTTIME_USERNAME=your_watttime_username
WATTTIME_PASSWORD=your_watttime_password

# Server config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info